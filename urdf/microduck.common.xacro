<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materials -->
  <material name="microduck_grey">
    <color rgba="0.322 0.322 0.337 1.0"/>
  </material>
  <material name="microduck_cream">
    <color rgba="0.969 0.902 0.796 1.0"/>
  </material>
  <material name="microduck_orange">
    <color rgba="0.973 0.306 0.020 1.0"/>
  </material>
  <material name="microduck_yellow">
    <color rgba="0.996 0.580 0.016 1.0"/>
  </material>
  <material name="microduck_motor">
    <color rgba="0.075 0.075 0.075 1.0"/>
  </material>
  <material name="microduck_bearing">
    <color rgba="0.659 0.667 0.675 1.0"/>
  </material>
  <material name="microduck_pcb">
    <color rgba="0.110 0.110 0.118 1.0"/>
  </material>
  <material name="microduck_battery">
    <color rgba="0.075 0.075 0.075 1.0"/>
  </material>
  <material name="microduck_lens">
    <color rgba="0.039 0.047 0.055 1.0"/>
  </material>

  <!-- Joint Limits (from MJCF) -->
  <xacro:property name="left_hip_yaw_lower" value="-0.436"/>
  <xacro:property name="left_hip_yaw_upper" value="0.524"/>
  <xacro:property name="left_hip_roll_lower" value="-0.384"/>
  <xacro:property name="left_hip_roll_upper" value="0.384"/>
  <xacro:property name="left_hip_pitch_lower" value="-1.571"/>
  <xacro:property name="left_hip_pitch_upper" value="1.571"/>
  <xacro:property name="left_knee_lower" value="-2.094"/>
  <xacro:property name="left_knee_upper" value="-0.035"/>
  <xacro:property name="left_ankle_lower" value="-1.222"/>
  <xacro:property name="left_ankle_upper" value="1.222"/>
  <xacro:property name="right_hip_yaw_lower" value="-0.524"/>
  <xacro:property name="right_hip_yaw_upper" value="0.436"/>
  <xacro:property name="right_hip_roll_lower" value="-0.384"/>
  <xacro:property name="right_hip_roll_upper" value="0.384"/>
  <xacro:property name="right_hip_pitch_lower" value="-1.571"/>
  <xacro:property name="right_hip_pitch_upper" value="1.571"/>
  <xacro:property name="right_knee_lower" value="-2.094"/>
  <xacro:property name="right_knee_upper" value="-0.035"/>
  <xacro:property name="right_ankle_lower" value="-1.222"/>
  <xacro:property name="right_ankle_upper" value="1.222"/>
  <xacro:property name="neck_pitch_lower" value="-0.436"/>
  <xacro:property name="neck_pitch_upper" value="0.873"/>
  <xacro:property name="head_pitch_lower" value="-1.222"/>
  <xacro:property name="head_pitch_upper" value="1.222"/>
  <xacro:property name="head_yaw_lower" value="-1.222"/>
  <xacro:property name="head_yaw_upper" value="1.222"/>
  <xacro:property name="head_roll_lower" value="-0.611"/>
  <xacro:property name="head_roll_upper" value="0.611"/>

  <!-- Jaw joint limits (15th motor) -->
  <xacro:property name="jaw_lower" value="0.0"/>
  <xacro:property name="jaw_upper" value="0.5"/>

</robot>
